# Copy to .env — never commit .env
# Run: cp .env.template .env && npm install && npm start

PORT=3000
NODE_ENV=development

# EPA AirNow — https://docs.airnowapi.org
AIRNOW_API_KEY=your_airnow_key

# OpenWeatherMap — https://openweathermap.org/api
OPENWEATHER_API_KEY=your_openweather_key

# Apple Maps Server API auth token used by apple-maps-server-sdk
# Generate from: https://maps.developer.apple.com/token-maker
APPLE_MAPS_AUTH_TOKEN=your_mapkit_js_authorization_token

# APNs push notifications (add when Apple credentials are ready)
# See: https://developer.apple.com/documentation/usernotifications
APNS_KEY_ID=your_key_id
APNS_TEAM_ID=your_team_id
APNS_BUNDLE_ID=com.yourorg.endoworld
APNS_KEY_PATH=./certs/AuthKey_XXXXXXXXXX.p8
